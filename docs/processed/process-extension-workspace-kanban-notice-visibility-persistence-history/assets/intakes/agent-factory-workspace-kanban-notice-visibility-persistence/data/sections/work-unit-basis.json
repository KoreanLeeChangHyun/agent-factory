      "content": {
        "id": "agent-factory-workspace-kanban-notice-visibility-persistence",
        "goal": "Kanban notice를 제거하고 칼럼 표시를 영속화하며 카드를 정적 타이틀 전용 항목으로 단순화한다.",
        "scope": [
          "notice DOM, CSS와 일반 상태 쓰기 제거",
          "localStorage 기반 칼럼 표시 저장 및 복원",
          "카드의 타이틀 외 content와 모든 상호작용 제거",
          "Specification 정렬",
          "focused unit and package checks"
        ],
        "expectedOutputs": [
          "notice 라인이 없는 Kanban UI",
          "영속화된 칼럼 표시 설정",
          "정적 타이틀 전용 카드",
          "정렬된 Specification과 검증 evidence"
        ],
        "exclusions": [
          "카드 액션과 DnD 재도입",
          "manager transition과 error contract 변경",
          "Human 결정 없는 integration과 배포"
        ],

        "specificationImpactRef": "SPECIFICATION-IMPACT-001",
        "executionOrder": 1,
        "scope": [
          "Project Core와 요구사항 Specification 정렬",
          "agents 독립 Extension manifest와 host 진입점",
          "native Activity Bar View Container",
          "실제 Workspace Explorer Tree View",
          "Main 및 Workflow Chat 탭",
          "로컬 세션 생성, 선택과 세션별 Composer draft",
          "SVG icon, CSP, 키보드 접근성과 테스트"
        ],
        "outOfScope": [
          "메시지 전송과 backend 연결",
          "원격 세션 복원과 스트리밍",
          "../web과 workspace 수정",
          "오른쪽 Workspace 포팅",
          "main 병합, push, 배포와 PR 승격"
        ],
        "expectedOutputs": [
          ".agent-factory/specifications/project-core",
          ".agent-factory/specifications/agent-factory-workspace-requirements",
          "agents/package.json",
          "agents/src/extension.js",
          "agents/src/explorerTree.js",
          "agents/src/chatView.js",
          "agents/media/agent-factory.svg",
          "agents/test",

{
    // IntelliSense를 사용하여 가능한 특성에 대해 알아보세요.
    // 기존 특성에 대한 설명을 보려면 가리킵니다.
    // 자세한 내용을 보려면 https://go.microsoft.com/fwlink/?linkid=830387을(를) 방문하세요.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Main Chat Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "${input:agentFactoryTestProject}",
                "--extensionDevelopmentPath=${workspaceFolder}/extension"
            ],
            "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
            "preLaunchTask": "build: extension",
            "env": {
                "AGENT_FACTORY_DEV_PLUGIN_ROOT": "${workspaceFolder}/plugin"
            }
        }
    ],
    "inputs": [
        {
            "id": "agentFactoryTestProject",
            "type": "promptString",
            "description": "Extension Development Host에서 열 테스트 프로젝트의 절대 경로"
        }
    ]
}

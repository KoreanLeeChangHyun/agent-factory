{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Edit(.agent-factory/engine/**)",
      "Edit(.agent-factory/hooks/**)",
      "Edit(.agent-factory/prompts/**)",
      "Edit(.agent-factory/docs/**)",
      "Edit(.agent-factory/build-assets/**)",
      "Edit(.agent-factory/board/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/commands/**)",
      "Edit(.claude/rules/**)",
      "Write(.claude/skills/**)",
      "Write(.claude/agents/**)",
      "Write(.claude/commands/**)",
      "Write(.claude/rules/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/engine/apps/hooks/statusline.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agent-factory/bin/flow-history sync && $CLAUDE_PROJECT_DIR/.agent-factory/bin/flow-history archive",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/board/server.py",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/session-start.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/pre-tool-use.py",
            "statusMessage": "pre-tool-use 디스패처 실행 중..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/subagent-stop.py",
            "timeout": 10,
            "statusMessage": "subagent-stop 디스패처 실행 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/post-tool-use.py",
            "timeout": 30,
            "async": true,
            "statusMessage": "post-tool-use 디스패처 실행 중..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/user-prompt-submit.py",
            "timeout": 3,
            "statusMessage": "user-prompt-submit 디스패처 실행 중..."
          }
        ]
      }
    ]
  }
}

#!/usr/bin/env bash
# T-513 P4 — v2 driver entry rewiring.
# Old text: engine/flow/http_launcher.py (V1 launcher) → P5 was discarded in bulk.
# New: Call engine/apps/cli/flow_wf.py. Equivalent to `flow-wf submit T-NNN`
# (Direct driver argument passing without subcommand).
ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel 2>/dev/null)" \
  || ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT" || exit 1
exec env PYTHONPATH="$ROOT/.agent-factory:$PYTHONPATH" \
  python3 -m engine.apps.cli.flow_wf "$@"

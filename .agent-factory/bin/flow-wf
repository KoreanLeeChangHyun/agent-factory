#!/usr/bin/env bash
# workflow driver wrapper (T-489 / SPEC.md §12.1)
# Call: flow-wf submit WR-NNN [--step PLAN]
ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel 2>/dev/null)" \
  || ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
subcmd="${1:-}"
shift || true
case "$subcmd" in
  -h|--help|help)
    cat <<EOF
flow-wf — v2 workflow driver (T-489)
usage:
  flow-wf submit WR-NNN [--step STEP]  # driver 1 cycle
  flow-wf submit WR-NNN --step PLAN    # debug: stop at a specific step
EOF
    exit 0
    ;;
  submit)
    cd "$ROOT" || exit 1
    exec env PYTHONPATH="$ROOT/.agent-factory:$PYTHONPATH" \
      python3 -m engine.apps.cli.flow_wf "$@"
    ;;
  *)
    cat <<EOF
flow-wf — v2 workflow driver (T-489)
usage:
  flow-wf submit WR-NNN [--step STEP]  # driver 1 cycle firing
  flow-wf submit WR-NNN --step PLAN    # Debug: Only up to a specific step
EOF
    exit 2
    ;;
esac

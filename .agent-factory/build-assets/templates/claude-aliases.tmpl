# This file is generated by build.sh.
# Agent Factory aliases for Claude Code
# NOTE: No flow-* alias definitions — only sets .agent-factory/bin/ wrapper PATH.
#       flow-* commands are provided through bin/ wrapper scripts.
#       In the Claude Code Bash tool (non-interactive), the CLAUDE_ENV_FILE in the SessionStart hook
#       The mechanism injects the PATH, which is a fallback for the interactive shell environment.
export PATH="$HOME/.local/bin:$PATH"

# flow-* wrapper PATH settings
# (1) Fixed path based on CLAUDE_PROJECT_DIR (for Claude Code Bash tool non-interactive environment)
if [ -n "$CLAUDE_PROJECT_DIR" ] && [ -d "$CLAUDE_PROJECT_DIR/.agent-factory/bin" ]; then
  export PATH="$CLAUDE_PROJECT_DIR/.agent-factory/bin:$PATH"
fi

# (2) git rev-parse based dynamic path (interactive shell fallback)
if [ -z "$CLAUDE_PROJECT_DIR" ]; then
  _cwf_root="$(git rev-parse --show-toplevel 2>/dev/null)"
  if [ -n "$_cwf_root" ] && [ -d "$_cwf_root/.agent-factory/bin" ]; then
    export PATH="$_cwf_root/.agent-factory/bin:$PATH"
  fi
  unset _cwf_root
fi

alias cc='claude --dangerously-skip-permissions'
alias ccc='claude --dangerously-skip-permissions --continue'
alias ccv='claude --dangerously-skip-permissions'
cct() {
  local i=0 name="main"
  while tmux has-session -t "$name" 2>/dev/null; do
    name="main-$((++i))"
  done
  tmux new-session -s "$name" "claude --dangerously-skip-permissions"
}

{
  "statusLine": {
    "type": "command",
    "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/engine/statusline.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/engine/sync/history_sync.py sync && python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/engine/sync/history_sync.py archive",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/board/server.py",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/session-start.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/pre-tool-use.py",
            "statusMessage": "pre-tool-use Running dispatcher..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/subagent-stop.py",
            "timeout": 10,
            "statusMessage": "subagent-stop Running dispatcher..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/post-tool-use.py",
            "timeout": 30,
            "async": true,
            "statusMessage": "Running post-tool-use dispatcher..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -u $CLAUDE_PROJECT_DIR/.agent-factory/hooks/user-prompt-submit.py",
            "timeout": 3,
            "statusMessage": "user-prompt-submit Running dispatcher..."
          }
        ]
      }
    ]
  }
}

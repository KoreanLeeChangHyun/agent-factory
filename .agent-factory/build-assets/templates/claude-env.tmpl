# =========================================================================================
# .agent-factory/.env — Agent Factory environment variables
# This file is generated by build.sh.
# Format: KEY=value (standard .env syntax)
# Please register with .gitignore as it may contain sensitive information.
# =========================================================================================

# -----------------------------------------------------------------------------------------
# (1) Brain adapter settings
# -----------------------------------------------------------------------------------------

# LLM adapter settings.
# Brain provider for provider-neutral LLM adapter paths.
# Supported values: claude / codex / fake
AGENT_FACTORY_LLM_PROVIDER=claude

# Claude adapter permission mode for non-interactive runs.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Codex adapter settings.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never

# -----------------------------------------------------------------------------------------
# (2) Slack integration
# -----------------------------------------------------------------------------------------

# Slack notification settings.
# Slack Bot OAuth Token (starts with xoxb-)
# Purpose: Sending Agent Factory task completion/waiting notifications
AGENT_FACTORY_SLACK_BOT_TOKEN=

# Slack channel ID (starts with C)
# Purpose: Specifies the channel through which notifications will be sent.
AGENT_FACTORY_SLACK_CHANNEL_ID=

# Slack API endpoint (can be overridden)
AGENT_FACTORY_SLACK_API_URL=https://slack.com/api/chat.postMessage

# -----------------------------------------------------------------------------------------
# (3) Git identity settings
# -----------------------------------------------------------------------------------------

# Git identity settings.
AGENT_FACTORY_GIT_USER_NAME=
AGENT_FACTORY_GIT_USER_EMAIL=
AGENT_FACTORY_GITHUB_USERNAME=
AGENT_FACTORY_SSH_KEY_GITHUB=

# -----------------------------------------------------------------------------------------
# (4) Hook control flag (HOOK_* system)
# Control the activation/deactivation of each hook with true/false.
# -----------------------------------------------------------------------------------------

# pre-tool-use hooks
HOOK_DANGEROUS_COMMAND=false
HOOK_HOOKS_SELF_PROTECT=false
HOOK_SLACK_ASK=false
HOOK_TASK_HISTORY_SYNC=false
HOOK_AGENT_INVESTIGATION_GUARD=false
HOOK_MAIN_BRANCH_GUARD=false
HOOK_MAIN_SESSION_GUARD=false
HOOK_CONVEYOR_SUBCOMMAND_GUARD=false
HOOK_READONLY_SESSION_GUARD=false
HOOK_DIRECT_PATH_GUARD=true
HOOK_COMPLETE_RELATION_GUARD=true
HOOK_RULES_AUTO_APPROVE=true
HOOK_WORKTREE_REMOVE_GUARD=true
HOOK_WORKTREE_PATH_GUARD=true
HOOK_HALLUCINATION_LOGGER=true
HOOKS_EDIT_ALLOWED=

# V2 workflow orchestration is driven by `flow-wf submit WR-NNN`.
# Historical flow-init/flow-step/flow-phase/flow-finish banner wrappers are not
# part of the active operator contract.
HOOK_WORKFLOW_ORCHESTRATION=true

# session-start hooks
HOOK_SESSION_SYSTEM_PROMPT=true

# stop hooks
HOOK_WORKFLOW_AUTO_CONTINUE=false

# subagent-stop hooks
HOOK_USAGE_TRACKER=true
HOOK_HISTORY_SYNC_TRIGGER=false

# post-tool-use hooks
HOOK_CATALOG_SYNC=true

# user-prompt-submit hooks (main session Conveyor/session snapshot injection)
HOOK_USER_PROMPT_CONVEYOR=true

# Auditor T3 — LLM judge advisory layer (T-477).
# Disabled by default (requires user-specified activation, adheres to speculative auto-enforcement policy canon).
# When activated, finalization.py Step 4c-AUDIT is called as a non-blocking advisory — verdict
# The result is that no Conveyor transition/merge flow is blocked or forced (T-411 canon).
HOOK_AUDITOR_T3=false
AUDITOR_T3_MODEL=
AUDITOR_T3_EFFORT=low

# -----------------------------------------------------------------------------------------
# (5) Enforced rule control flags (ENFORCE_* scheme)
# true/false controls the activation/deactivation of each enforcement rule.
# -----------------------------------------------------------------------------------------

# CSO principles (limited to skill description trigger conditions only)
ENFORCE_CSO_PRINCIPLE=true

# Enforce anti-rationalization tables
ENFORCE_RATIONALIZATION_GUARD=true

# Verification Result Table required
ENFORCE_VRT=true

# Force Self-Review Checklist
ENFORCE_SELF_REVIEW=true

# Force token efficiency target value
ENFORCE_TOKEN_EFFICIENCY=true

# -----------------------------------------------------------------------------------------
# (6) Agent Factory workflow settings
# -----------------------------------------------------------------------------------------

# Maximum number of workflows to keep in the .agent-factory/runs/ directory (default: 10)
AGENT_FACTORY_WORKFLOW_KEEP_COUNT=10

# Maximum number of retries when chain stage fails (default: 2)
AGENT_FACTORY_CHAIN_MAX_RETRY=2

# Enable git worktree isolation (single source of truth — successor to T-370)
# Allowed values: true (isolation active, recommended) / false (disabled, work directly with main repository)
# When unset: is_worktree_enabled() raises RuntimeError — inference fallback removed
# Used in: .agent-factory/engine/flow/worktree_manager.py
WORKFLOW_WORKTREE=true

# Prompt quality threshold (0.0 to 1.0). Automatic rollback when insufficient
AGENT_FACTORY_QUALITY_THRESHOLD=0.6

# ERROR count threshold per workflow
AGENT_FACTORY_ERROR_THRESHOLD=3

# Session/workflow stale determination (in minutes)
AGENT_FACTORY_STALE_TTL_MINUTES=30

# Zombie session verdict (unit of time)
AGENT_FACTORY_ZOMBIE_TTL_HOURS=24

# Report TTL (in hours)
AGENT_FACTORY_REPORT_TTL_HOURS=1

# Working directory name maximum length
AGENT_FACTORY_WORK_NAME_MAX_LEN=20

# Maximum number of retry per phase (default value 0 = retry inactive, 0 regressions guaranteed)
# T-455: retry/sentinel/flow-fail-record infrastructure. Retry only works when explicitly activated.
WORKFLOW_RETRY_INIT=0
WORKFLOW_RETRY_PLAN=0
WORKFLOW_RETRY_WORK=0
WORKFLOW_RETRY_VALIDATE=0
WORKFLOW_RETRY_REPORT=0

# retry-context.json hint_history array cap (LIFO truncate, default 3)
WORKFLOW_RETRY_PROMPT_N=3

# Terminal banner width (automatic if empty)
AGENT_FACTORY_BANNER_WIDTH=

# -----------------------------------------------------------------------------------------
# (7) Bootstrap and external source settings
# -----------------------------------------------------------------------------------------

# Remote repository URL (can be overridden)
AGENT_FACTORY_REPO_URL=https://github.com/KoreanLeeChangHyun/claude-workflow.git

# Python minimum version (verified build.sh)
AGENT_FACTORY_REQUIRED_PYTHON_MAJOR=3
AGENT_FACTORY_REQUIRED_PYTHON_MINOR=9
